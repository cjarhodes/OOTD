# Copy into Vercel → Project → Settings → Environment Variables (Production only).
# None of these are needed for the public sample demo; without them, owner and AI features stay off.

# Owner access: the passphrase you type in Settings to unlock AI tagging on your phone.
OOTD_OWNER_PASSPHRASE=
# Random secret for signing the owner session cookie, at least 32 characters (e.g. `openssl rand -base64 48`).
OOTD_SESSION_SECRET=

# Anthropic API key, from a dedicated Console workspace with its own monthly spend limit.
ANTHROPIC_API_KEY=
# Optional: model for tagging (default claude-opus-5-5). claude-haiku-5-5 is far cheaper per photo.
OOTD_AI_MODEL=

# Spending tracker: Upstash Redis from the Vercel Marketplace sets these automatically.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Monthly cap in US dollars (default 3).
OOTD_AI_MONTHLY_CAP_USD=3
# Optional: prices used to count spend, per million tokens. Defaults (5 / 25) are deliberately high.
OOTD_AI_INPUT_USD_PER_MTOK=
OOTD_AI_OUTPUT_USD_PER_MTOK=
