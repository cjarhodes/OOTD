# Copy into Vercel → Project → Settings → Environment Variables.
# Without a Blob store and Resend key, the app runs as the sample wardrobe only.

# Accounts, wardrobes and photos: a private Vercel Blob store connected to the project sets this.
BLOB_READ_WRITE_TOKEN=

# Sign-in emails, through Resend (free tier is plenty).
RESEND_API_KEY=
# The sender, on a domain verified in Resend. Without it, Resend's test sender only reaches your own Resend address.
OOTD_EMAIL_FROM=OOTD <signin@example.com>
# Optional: sign sessions with this (32+ characters). Otherwise a key is generated once and kept in the Blob store.
OOTD_SESSION_SECRET=

# AI tagging (optional). Anthropic API key from a dedicated Console workspace with its own monthly spend limit.
ANTHROPIC_API_KEY=
# Optional: model for tagging (default claude-opus-5-5). claude-haiku-5-5 is far cheaper per photo.
OOTD_AI_MODEL=
# AI tags each person may use per month (default 20).
OOTD_AI_TAGS_PER_MONTH=20
# Optional: comma-separated emails with no per-person limit (the overall monthly cap still applies).
OOTD_OWNER_EMAILS=

# Spending tracker: Upstash Redis from the Vercel Marketplace sets these automatically.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.) Without it, AI tagging stays off.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Overall monthly cap in US dollars across everyone (default 3).
OOTD_AI_MONTHLY_CAP_USD=3
# Optional: prices used to count spend, per million tokens. Defaults (5 / 25) are deliberately high.
OOTD_AI_INPUT_USD_PER_MTOK=
OOTD_AI_OUTPUT_USD_PER_MTOK=
